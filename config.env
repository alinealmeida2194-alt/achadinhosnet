# Configurações do bot (pode editar direto pelo GitHub).
# Chaves e senhas NÃO vão aqui: ficam em Settings > Secrets and variables > Actions.

PALAVRAS_CHAVE=fone bluetooth,air fryer,smartwatch,organizador,maquiagem,garrafa termica
DESCONTO_MINIMO=20
POSTS_POR_RODADA=2

TELEGRAM_LINK_PUBLICO=t.me/seucanal

IG_FEED=nao
GRAPH_VERSION=v21.0
GRAPH_HOST=graph.instagram.com
INSTAGRAM_HASHTAGS=#achadinhos #promocao #oferta #shopee #mercadolivre
PALAVRA_COMENTARIO=QUERO
RESPONDER_NO_POST=sim

# automatico | manual | nao
STORY_MODO=manual
# cor da arte: rosa | laranja | azul | verde | lilas
STORY_TEMA=rosa
# texto do botão (linha1|linha2). Vazio = padrão
STORY_CHAMADA=

VITRINE_TITULO=Achadinhos
VITRINE_MAX=60
