# Copie este arquivo para .env e preencha.

# --- Shopee (painel de afiliados > Open API) ---
SHOPEE_APP_ID=
SHOPEE_SECRET=

# --- Mercado Livre ---
# Gere um link no painel de afiliados e copie os valores de matt_word e matt_tool
ML_MATT_WORD=
ML_MATT_TOOL=
# Opcional: token da API do ML para buscar produtos automaticamente
ML_ACCESS_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=          # criado no @BotFather
TELEGRAM_CHAT_ID=@seucanal   # bot precisa ser admin do canal
TELEGRAM_LINK_PUBLICO=t.me/seucanal

# --- Instagram (conta Profissional ligada a uma Página do Facebook) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v21.0
GRAPH_HOST=graph.facebook.com
# Para responder comentários/directs: com Login do Facebook use o ID da Página aqui;
# com Login do Instagram (GRAPH_HOST=graph.instagram.com) deixe vazio.
IG_MENSAGENS_ID=
INSTAGRAM_HASHTAGS=#achadinhos #promocao #oferta #shopee #mercadolivre
IG_FEED=sim
PALAVRA_COMENTARIO=QUERO
RESPONDER_NO_POST=sim

# --- Stories ---
# automatico = posta sozinho com "Responda QUERO e receba o link"
# manual     = manda a arte + link para o SEU Telegram, você posta com link sticker
# nao        = não faz story
STORY_MODO=automatico
TELEGRAM_ADMIN_CHAT_ID=      # seu chat pessoal com o bot (para o modo manual)
IMGBB_API_KEY=               # grátis em api.imgbb.com — hospeda a arte da story
STORY_CHAMADA=

# --- Vitrine (link da bio) ---
VITRINE_TITULO=Achadinhos
VITRINE_MAX=60

# --- Comportamento ---
PALAVRAS_CHAVE=fone bluetooth,air fryer,smartwatch,organizador
DESCONTO_MINIMO=20
POSTS_POR_RODADA=3
INTERVALO_MINUTOS=60
